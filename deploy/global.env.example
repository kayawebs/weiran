# Copy to deploy/global.env. Server-side values; do not copy to apps/web.
COMPOSE_PROJECT_NAME=weiran-global
ENV_FILE=deploy/global.env
NODE_ENV=production
DEPLOYMENT_MARKET=global
API_HOST=0.0.0.0
API_PORT=3000
# Host-only diagnostics port. The container still listens on API_PORT=3000.
API_PUBLIC_PORT=3001
LOG_LEVEL=info
TRUST_PROXY=true
CORS_ORIGINS=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
WEB_PORT=8080

# Public values compiled into the English Web bundle.
WEB_AD_PROVIDER=none
WEB_AD_SLOT_HOME=
WEB_AD_SLOT_TOOLS=
WEB_AD_SLOT_RESULT=

ALLOW_INSECURE_DEV_AUTH=false
ENABLE_WEB_GUEST_AUTH=true
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
# Global Web uses guest JWT auth and does not require WeChat credentials.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Generated once by ./deploy/init-global-env.sh. Do not hand-write this in production.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=weiran-lab-global
JWT_AUDIENCE=weiran-lab-clients
JWT_TTL_SECONDS=604800

DATABASE_URL=postgresql://creator:replace-password@postgres:5432/creator_tools
REDIS_URL=redis://redis:6379
# Generated once by ./deploy/init-global-env.sh. The script also updates DATABASE_URL.
POSTGRES_PASSWORD=replace-with-url-safe-database-password
TASK_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2

# Choose the Alibaba Cloud region closest to the overseas deployment.
OSS_REGION=oss-ap-southeast-1
OSS_BUCKET=replace-with-global-private-bucket
OSS_ACCESS_KEY_ID=replace-with-global-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-global-ram-access-key-secret
OSS_INTERNAL_ENDPOINT=https://oss-ap-southeast-1-internal.aliyuncs.com
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=524288000
