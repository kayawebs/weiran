# Copy to deploy/cn.env. Server-side values; do not copy to apps/web.
COMPOSE_PROJECT_NAME=weiran-cn
ENV_FILE=deploy/cn.env
NODE_ENV=production
DEPLOYMENT_MARKET=cn
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
CORS_ORIGINS=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
WEB_PORT=8080

# Public values compiled into the Chinese Web bundle.
WEB_AD_PROVIDER=none
WEB_AD_SLOT_HOME=
WEB_AD_SLOT_TOOLS=
WEB_AD_SLOT_RESULT=

ALLOW_INSECURE_DEV_AUTH=false
ENABLE_WEB_GUEST_AUTH=true
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
WECHAT_APP_ID=wxa5c763c97869a2aa
WECHAT_APP_SECRET=replace-with-wechat-app-secret
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=weiran-lab-cn
JWT_AUDIENCE=weiran-lab-clients
JWT_TTL_SECONDS=604800

DATABASE_URL=postgresql://creator:replace-password@postgres:5432/creator_tools
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=replace-with-url-safe-database-password
TASK_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-cn-private-bucket
OSS_ACCESS_KEY_ID=replace-with-cn-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-cn-ram-access-key-secret
OSS_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=524288000
