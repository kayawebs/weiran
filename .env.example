# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
# Leave blank when Web and API share one domain through the bundled Nginx proxy.
# For separate frontend domains, use a comma-separated allowlist.
CORS_ORIGINS=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
WEB_PORT=8080
# Never leave true in a public environment. The fallback is only for local development.
ALLOW_INSECURE_DEV_AUTH=true
ENABLE_WEB_GUEST_AUTH=true
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001

# WeChat authentication / JWT (required for public deployment)
WECHAT_APP_ID=wxa5c763c97869a2aa
WECHAT_APP_SECRET=
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=ai-creator-tools
JWT_AUDIENCE=ai-creator-tools-miniprogram
JWT_TTL_SECONDS=604800

# Docker PostgreSQL / Redis
# Docker Compose replaces these hostnames inside API/Worker containers.
DATABASE_URL=postgresql://creator:creator@localhost:5432/creator_tools
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=creator
TASK_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2

# Alibaba Cloud OSS. Use a RAM user with a bucket-prefix-only policy.
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=creator-media
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
# Optional ECS-to-OSS VPC endpoint, e.g. oss-cn-hangzhou-internal.aliyuncs.com
OSS_INTERNAL_ENDPOINT=
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=524288000
