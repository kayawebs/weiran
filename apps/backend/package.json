{
  "name": "@creator-tools/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "migrate:production": "node dist/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "ali-oss": "^6.23.0",
    "bullmq": "^5.58.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ali-oss": "^6.16.13",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
