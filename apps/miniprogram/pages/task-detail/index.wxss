.status-card { display: flex; gap: 22rpx; align-items: center; }
.status-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex: none; }
.pending { background: #ffb400; }
.processing { background: #2f6bff; animation: pulse 1.3s infinite; }
.success { background: #00b42a; }
.failed { background: #f53f3f; }
.results-section { margin-top: 30rpx; }
.results-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 8rpx 18rpx; }
.result-count { color: #86909c; font-size: 24rpx; }
.result-card { margin-bottom: 24rpx; }
.result-title { color: #1d2129; font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.result-image { width: 100%; border-radius: 16rpx; background: #f2f3f5; }
.result-video { width: 100%; border-radius: 16rpx; background: #0d1326; }
.secondary-button { background: #edf2ff; color: #2f6bff; border-radius: 16rpx; font-size: 28rpx; margin-top: 16rpx; }
.error-card { border: 1rpx solid #ffd0cc; }
.retry-button { color: #2f6bff; background: #edf2ff; margin-top: 24rpx; border-radius: 14rpx; }
.timeline { padding: 12rpx 18rpx; }
.event { display: grid; grid-template-columns: 126rpx 1fr; gap: 16rpx; padding: 18rpx 0; color: #4e5969; font-size: 26rpx; }
.event-status { color: #86909c; font-size: 23rpx; }
.event-time { color: #c9cdd4; font-size: 22rpx; margin-top: 7rpx; }
@keyframes pulse { 50% { opacity: .35; } }
