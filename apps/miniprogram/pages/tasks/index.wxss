.tasks-page { padding-top: 38rpx; }.filter-header { padding: 0 4rpx 30rpx; }.empty-card { background: #fff; border-radius: 24rpx; padding: 78rpx 42rpx; text-align: center; color: #86909c; }.empty-icon { font-size: 60rpx; color: #b7c7ff; }.empty-title { color: #1d2129; font-size: 30rpx; font-weight: 600; margin-top: 18rpx; }.empty-description { font-size: 24rpx; line-height: 1.7; margin-top: 12rpx; }.empty-action { display: inline-block; color: #1677ff; margin-top: 26rpx; font-size: 27rpx; }.task-list { background: #fff; padding: 0 28rpx; border-radius: 24rpx; }.task-row { min-height: 126rpx; display: flex; align-items: center; border-bottom: 1rpx solid #f2f3f5; }.task-row:last-child { border-bottom: 0; }.task-symbol { width: 58rpx; height: 58rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 25rpx; font-weight: 700; }.task-main { flex: 1; margin-left: 18rpx; }.task-name { font-size: 28rpx; font-weight: 600; }.task-time { font-size: 22rpx; color: #86909c; margin-top: 7rpx; }.task-status { font-size: 22rpx; padding: 6rpx 10rpx; border-radius: 9rpx; }.pending { color: #c77a00; background: #fff5db; }.processing { color: #1677ff; background: #e8f3ff; }.success { color: #1f9d55; background: #eaf8ef; }.failed { color: #dc4446; background: #fff0f0; }.arrow { color: #c9cdd4; margin-left: 10rpx; font-size: 38rpx; }
