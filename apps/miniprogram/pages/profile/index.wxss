.profile-page { padding-top: 40rpx; }.profile-card { display: flex; align-items: center; background: #0b1a34; color: #fff; padding: 34rpx; border-radius: 26rpx; }.profile-icon { width: 88rpx; height: 88rpx; border-radius: 22rpx; margin-right: 22rpx; }.profile-name { font-size: 32rpx; font-weight: 650; }.profile-description { color: #b9cce1; font-size: 24rpx; margin-top: 9rpx; }.summary-card { display: flex; align-items: center; justify-content: space-around; text-align: center; background: #fff; border-radius: 24rpx; padding: 28rpx; margin: 24rpx 0; }.summary-number { color: #1677ff; font-size: 42rpx; font-weight: 700; }.summary-label { color: #86909c; font-size: 23rpx; margin-top: 7rpx; }.summary-divider { height: 58rpx; border-left: 1rpx solid #f0f0f0; }.menu-card { background: #fff; padding: 0 28rpx; border-radius: 24rpx; }.menu-row { min-height: 132rpx; display: flex; align-items: center; border-bottom: 1rpx solid #f2f3f5; }.menu-row:last-child { border-bottom: 0; }.menu-icon { width: 60rpx; height: 60rpx; border-radius: 17rpx; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 600; }.menu-content { flex: 1; margin-left: 18rpx; font-size: 28rpx; font-weight: 550; }.menu-content view:last-child { color: #86909c; font-size: 22rpx; font-weight: 400; margin-top: 6rpx; }.arrow { color: #c9cdd4; font-size: 42rpx; }.profile-notice { color: #86909c; font-size: 22rpx; text-align: center; margin: 42rpx 20rpx; }
