.home-page { padding-bottom: 48rpx; }.hero-card { padding: 42rpx 34rpx; border-radius: 28rpx; background: linear-gradient(135deg, #07152d, #102d55); color: #fff; margin-bottom: 42rpx; }.brand-row { display: flex; align-items: center; gap: 16rpx; }.brand-icon { width: 64rpx; height: 64rpx; border-radius: 16rpx; }.brand-name { font-size: 31rpx; font-weight: 700; }.brand-caption { color: #a8c8f2; font-size: 23rpx; margin-top: 3rpx; }.hero-title { font-size: 47rpx; font-weight: 700; margin-top: 38rpx; letter-spacing: 1rpx; }.hero-description { color: #c3d7ec; font-size: 26rpx; line-height: 1.7; margin-top: 16rpx; }.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 34rpx 4rpx 20rpx; }.section-title { font-size: 32rpx; font-weight: 700; }.section-hint { color: #86909c; font-size: 23rpx; margin-top: 6rpx; }.all-link { color: #1677ff; font-size: 25rpx; }.common-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }.common-card { background: #fff; padding: 28rpx; border-radius: 24rpx; min-height: 214rpx; box-sizing: border-box; }.tool-symbol { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: #fff; font-size: 31rpx; font-weight: 700; }.tool-symbol.small { width: 58rpx; height: 58rpx; border-radius: 16rpx; font-size: 26rpx; }.blue { background: linear-gradient(135deg, #4e91ff, #2f63e9); }.purple { background: linear-gradient(135deg, #8f6aff, #6846d9); }.cyan { background: linear-gradient(135deg, #36cfc9, #1682b4); }.orange { background: linear-gradient(135deg, #ffab57, #ec6f35); }.pink { background: linear-gradient(135deg, #fc7db5, #d44b85); }.green { background: linear-gradient(135deg, #56c981, #249a62); }.common-name { font-size: 30rpx; font-weight: 600; margin-top: 20rpx; }.common-description { color: #86909c; font-size: 23rpx; line-height: 1.5; margin-top: 8rpx; }.category-card { background: #fff; padding: 28rpx; border-radius: 24rpx; margin-bottom: 20rpx; }.category-name { font-size: 30rpx; font-weight: 650; }.category-description { font-size: 23rpx; color: #86909c; margin-top: 6rpx; }.category-tools { margin-top: 22rpx; }.category-tool { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid #f2f3f5; }.category-tool-main { margin-left: 18rpx; flex: 1; font-size: 27rpx; font-weight: 500; }.category-tool-description { color: #86909c; font-size: 22rpx; margin-top: 5rpx; font-weight: 400; }.future-badge { color: #86909c; background: #f2f3f5; padding: 6rpx 12rpx; border-radius: 10rpx; font-size: 21rpx; }.arrow { color: #c9cdd4; font-size: 42rpx; }.notice { color: #86909c; font-size: 22rpx; text-align: center; margin: 42rpx 16rpx 12rpx; }
