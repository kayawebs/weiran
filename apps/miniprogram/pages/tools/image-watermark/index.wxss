.tool-page-intro { padding: 16rpx 6rpx 30rpx; }.preview, .empty-preview { width: 100%; max-height: 560rpx; border-radius: 16rpx; margin: 24rpx 0 10rpx; }.empty-preview { height: 300rpx; background: #f2f3f5; display: flex; align-items: center; justify-content: center; color: #86909c; }.secondary-button { background: #edf2ff; color: #2f6bff; border-radius: 14rpx; font-size: 28rpx; }.region-help { margin: 14rpx 0 16rpx; line-height: 1.6; }.region-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.region-grid label text { display: block; color: #4e5969; font-size: 24rpx; margin-bottom: 8rpx; }.mode-group { display: flex; gap: 34rpx; margin-top: 26rpx; font-size: 27rpx; }
