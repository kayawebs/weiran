<view class="page video-link-page">
  <view class="tool-page-intro">
    <view class="eyebrow">素材获取 · 视频清理</view>
    <view class="title">视频去水印</view>
    <view class="subtitle">选择来源平台并粘贴公开链接，未然Lab 会自动识别页面中的视频并生成下载结果。</view>
  </view>

  <view class="card">
    <view class="step-row"><view class="step-number">1</view><view><view class="section-title">选择平台</view><view class="muted">不同平台使用独立解析策略</view></view></view>
    <view class="platform-grid">
      <view wx:for="{{platforms}}" wx:key="id" class="platform-card {{selectedPlatform === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectPlatform">
        <view class="platform-logo">D</view>
        <view class="platform-main"><view class="platform-name">{{item.name}}</view><view class="platform-description">{{item.description}}</view></view>
        <view class="selected-mark">✓</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="step-row"><view class="step-number">2</view><view><view class="section-title">粘贴链接</view><view class="muted">当前仅支持无需登录即可访问的公开页面</view></view></view>
    <view class="url-box">
      <textarea class="url-input" auto-height maxlength="1000" placeholder="{{placeholder}}" value="{{sourceUrl}}" bindinput="onUrlInput" />
      <button class="paste-button" bindtap="pasteUrl">粘贴</button>
    </view>
    <view class="feature-list">
      <view><text>✓</text> 自动发现页面中的全部视频</view>
      <view><text>✓</text> 自动匹配平台处理策略</view>
      <view><text>✓</text> 处理完成后提供独立下载项</view>
    </view>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">查找无水印源视频</button>
    <view class="rights-notice">提交即表示您确认拥有该素材，或已获得下载和处理授权。</view>
  </view>

  <view wx:if="{{results.length}}" class="results-section">
    <view class="results-topbar">
      <view><view class="found-count">● 找到 {{resultCount}} 个视频</view><view class="section-title">无水印源视频</view></view>
      <view class="expires-text">{{expiresText}}</view>
    </view>
    <view wx:for="{{results}}" wx:key="id" class="card source-result-card">
      <view class="result-summary">
        <image wx:if="{{item.coverUrl}}" class="source-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="source-cover source-cover-fallback">D</view>
        <view class="result-copy">
          <view class="result-title">{{item.title}}</view>
          <view class="result-tags">
            <text>{{item.qualityText}}</text><text class="clean-tag">无水印</text><text wx:if="{{item.sizeText}}">{{item.sizeText}}</text><text wx:if="{{item.durationText}}">{{item.durationText}}</text>
          </view>
        </view>
      </view>
      <video wx:if="{{previewingIndex === index}}" class="source-preview" src="{{item.previewUrl}}" poster="{{item.coverUrl}}" controls />
      <view class="result-actions">
        <button class="primary-button" data-index="{{index}}" loading="{{downloadingIndex === index}}" disabled="{{downloadingIndex >= 0}}" bindtap="saveResult">下载并保存</button>
        <button class="secondary-button" data-index="{{index}}" bindtap="togglePreview">{{previewingIndex === index ? '关闭预览' : '预览'}}</button>
      </view>
    </view>
  </view>
</view>
