page { background: #f7f8fa; color: #1d2129; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 32rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; box-sizing: border-box; }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.subtitle { color: #86909c; font-size: 26rpx; margin-top: 12rpx; line-height: 1.6; }
.primary-button { background: #2f6bff; color: #fff; border-radius: 16rpx; font-size: 30rpx; margin-top: 24rpx; }
.primary-button[disabled] { background: #b7c7ff; color: #fff; }
.field-label { display: block; margin: 24rpx 0 12rpx; color: #4e5969; font-size: 26rpx; }
.input { background: #f2f3f5; border-radius: 12rpx; padding: 20rpx; min-height: 44rpx; font-size: 28rpx; box-sizing: border-box; }
.muted { color: #86909c; font-size: 26rpx; }
.section-title { font-weight: 600; font-size: 30rpx; }
